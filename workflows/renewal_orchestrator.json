      "id": "node-cron-sweep",
      "name": "Cron: 15-Min Sweep",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [160, 500]
    },
    {
      "parameters": {
        "jsCode": "// Idempotency Guard & Deduplicator\nconst items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const event = item.json;\n  const invoiceId = String(event.id || event.invoice_id || '');\n  const status = String(event.payment_status || event.status || 'PAID');\n  const idempotencyKey = `idemp_${invoiceId}_${status}`;\n\n  // Deduplication check: in production, verify against Redis/KV store\n  results.push({\n    json: {\n      invoice_id: invoiceId,\n      payment_status: status,\n      idempotency_key: idempotencyKey,\n      trigger_source: event.id ? 'webhook' : 'cron_sweep',\n      received_at: new Date().toISOString()\n    }\n  });\n}\n\nreturn results;"
      },
      "id": "node-idempotency-guard",
      "name": "Idempotency Guard & Deduplicator",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [380, 400]
    },
    {
      "parameters": {
        "command": "/opt/homebrew/bin/python3.10 /Users/lambardaar/Downloads/bombios/main.py"
      },
      "id": "node-reconciliation-engine",
      "name": "Trigger Reconciliation Engine",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [580, 400]
    },
    {
      "parameters": {
        "jsCode": "// Ingest classification outputs from reconciliation engine CSV outputs\nconst fs = require('fs');\nconst path = '/Users/lambardaar/Downloads/bombios';\n\nfunction parseCSV(filePath) {\n  if (!fs.existsSync(filePath)) return [];\n  const content = fs.readFileSync(filePath, 'utf8').trim();\n  if (!content) return [];\n  const lines = content.split('\\n');\n  const headers = lines[0].split(',').map(h => h.trim().replace(/^\"|\"$/g, ''));\n  return lines.slice(1).map(line => {\n    const values = line.split(',').map(v => v.trim().replace(/^\"|\"$/g, ''));\n    const obj = {};\n    headers.forEach((h, i) => obj[h] = values[i] || '');\n    return obj;\n  });\n}\n\nconst autoApproved = parseCSV(`${path}/auto_approved.csv`).map(r => ({ ...r, routing_branch: 'AUTO_APPROVED' }));\nconst flagged = parseCSV(`${path}/flagged_exceptions.csv`).map(r => {\n  let branch = 'FLAGGED_EXCEPTION';\n  const code = r.primary_reason_code || '';\n  if (code.includes('PAYMENT_NOT_COMPLETED')) branch = 'PAYMENT_FAILED';\n  else if (code.includes('BATCH_CAPACITY_FULL') || code.includes('INACTIVE_BATCH')) branch = 'BATCH_UNAVAILABLE';\n  else if (code.includes('MISSING_FACULTY_FORM') || code.includes('UNMATCHED_INVOICE')) branch = 'MISSING_TEACHER_FORM';\n  else if (code.includes('DUPLICATE')) branch = 'DUPLICATE_BOOKING';\n  return { ...r, routing_branch: branch };\n});\nconst pending = parseCSV(`${path}/pending_human_review.csv`).map(r => {\n  let branch = 'PENDING_REVIEW';\n  const code = r.primary_reason_code || '';\n  if (code.includes('PARTIAL_PAYMENT')) branch = 'PARTIAL_PAYMENT';\n  else if (code.includes('MISMATCH') || code.includes('AMBIGUOUS')) branch = 'STUDENT_MISMATCH';\n  return { ...r, routing_branch: branch };\n});\n\nconst allRecords = [...autoApproved, ...flagged, ...pending];\nreturn allRecords.map(rec => ({ json: rec }));"
      },
